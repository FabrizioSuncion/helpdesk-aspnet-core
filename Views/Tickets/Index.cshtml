@model IEnumerable<HelpDesk.Models.Ticket>
@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tickets</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo ticket</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay tickets para mostrar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Título</th>
                    <th>Categoría</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th>Creado por</th>
                    <th>Técnico</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Titulo</td>
                    <td>@t.Categoria?.Nombre</td>
                    <td>@t.Prioridad</td>
                    <td>@t.Estado</td>
                    <td>@t.Creador?.NombreCompleto</td>
                    <td>@(t.Tecnico?.NombreCompleto ?? "Sin asignar")</td>
                    <td>@t.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
